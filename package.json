{
  "name": "@auphansoftware/cdp-cli",
  "version": "1.13.0",
  "description": "CLI for Chrome DevTools Protocol - optimized for LLM agents with NDJSON output",
  "type": "module",
  "bin": {
    "cdp-cli": "build/index.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/make-executable.mjs && node scripts/stamp-build.mjs",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "build:exe": "npm run build && node scripts/build-exe.mjs",
    "install:exe": "npm run build:exe && node scripts/install-exe.mjs",
    "doctor": "node build/index.js doctor",
    "prepack": "npm run build",
    "start": "npm run build && node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:live": "npm run build && vitest run --config vitest.live.config.ts",
    "test:live:headful": "npm run build && node -e \"process.env.CDP_LIVE_HEADFUL='1'; const r=require('node:child_process').spawnSync(process.execPath,['./node_modules/vitest/vitest.mjs','run','--config','vitest.live.config.ts'],{stdio:'inherit',env:process.env}); process.exit(r.status ?? 1)\"",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "chrome",
    "devtools",
    "cdp",
    "cli",
    "automation",
    "llm",
    "ndjson"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "build/**/*",
    "README.md"
  ],
  "dependencies": {
    "pngjs": "^7.0.0",
    "undici": "^6.22.0",
    "ws": "^8.18.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "^4.0.3",
    "@vitest/ui": "^4.0.3",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
